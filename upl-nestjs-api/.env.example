# API Configuration
API_PORT=3000
NODE_ENV=development # 'development', 'production', or 'test'

# Database (PostgreSQL)
DB_TYPE=postgres
DB_HOST=localhost # o 'db' si se ejecuta en Docker Compose y se accede desde el host
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=mysecretpassword # Cambiar esto
DB_DATABASE=upl_nest_db

# JWT Configuration
JWT_SECRET=yourSuperSecretKeyForJWT # Cambiar esto por una clave larga y segura
JWT_EXPIRATION_TIME=3600s # Ejemplo: 1 hora (s), 1 día (d)

# Optional: Para TypeORM CLI si se usa fuera de la app NestJS directamente
# TYPEORM_CONNECTION = postgres
# TYPEORM_HOST = localhost
# TYPEORM_PORT = 5432
# TYPEORM_USERNAME = postgres
# TYPEORM_PASSWORD = mysecretpassword
# TYPEORM_DATABASE = upl_nest_db
# TYPEORM_SYNCHRONIZE = true # Solo para desarrollo
# TYPEORM_LOGGING = true
# TYPEORM_ENTITIES = src/**/*.entity.ts
# TYPEORM_MIGRATIONS = src/migrations/*.ts
# TYPEORM_MIGRATIONS_DIR = src/migrations
# TYPEORM_MIGRATIONS_TABLE_NAME = migrations
